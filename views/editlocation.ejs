<!DOCTYPE html>
<html>
<head>
    <title>Edit Location</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="navbar">
        <h2>Bookminton</h2>
        <div>
            <a href="/">Home</a>
            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/locations">Edit Location</a>
            <% } else { %>
                <a href="/locations">View Locations</a>
            <% } %>
            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/feedback">Feedback</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/bookings">All Bookings</a>
                <a href="/admin-feedback">Feedbacks</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/my-bookings">My Bookings</a>
            <% } %>

            <% if (loggedInUser) { %>
                <% if (loggedInUser && loggedInUser.role === "user") { %>
                    <a href="/profile">Profile</a>
                <% } %>
                <span class="login-text">Hi, <%= loggedInUser.username %> (<%= loggedInUser.role %>)</span>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </div>

    <div class="container">
        <div class="form-box location-admin-box">
            <h1>Edit Location</h1>

            <% if (error) { %>
                <p class="error"><%= error %></p>
            <% } %>

            <form method="POST" action="/locations/edit/<%= index %>">
                <label>Location Name</label>
                <input type="text" name="locationName" value="<%= location.name %>" required>

                <label>Image URL</label>
                <input type="text" name="locationImage" value="<%= location.image %>" required>

                <label>Address</label>
                <input type="text" name="locationAddress" value="<%= location.address %>" required>

                <button type="submit">Update Location</button>
                <a class="btn secondary" href="/locations">Cancel</a>
            </form>

            <div class="preview-box">
                <h2>Preview</h2>
                <img src="<%= location.image %>" alt="<%= location.name %>">
                <p><strong><%= location.name %></strong></p>
                <p><%= location.address %></p>
            </div>
        </div>
    </div>

</body>
</html>
