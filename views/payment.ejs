<!DOCTYPE html>
<html>
<head>
    <title>Payment</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="navbar">
        <h2>Bookminton</h2>
        <div>
            <a href="/">Home</a>
            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/locations">Edit Location</a>
            <% } else { %>
                <a href="/locations">View Locations</a>
            <% } %>
            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/feedback">Feedback</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/bookings">All Bookings</a>
                <a href="/admin-feedback">Feedbacks</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/my-bookings">My Bookings</a>
            <% } %>

            <% if (loggedInUser) { %>
                <% if (loggedInUser && loggedInUser.role === "user") { %>
                    <a href="/profile">Profile</a>
                <% } %>
                <span class="login-text">Hi, <%= loggedInUser.username %> (<%= loggedInUser.role %>)</span>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </div>

    <div class="container">
        <div class="form-box payment-box">
            <h1>Payment Details</h1>

            <div class="payment-summary">
                <h3>Booking Summary</h3>
                <p><strong>Name:</strong> <%= bookingData.name %></p>
                <p><strong>Location:</strong> <%= bookingData.location %></p>
                <p><strong>Court:</strong> <%= bookingData.court %></p>
                <p><strong>Date:</strong> <%= bookingData.date %></p>
                <p><strong>Time:</strong> <%= bookingData.time %></p>
                <p><strong>Original Amount:</strong> $<%= originalAmount %></p>

                <% if (loggedInUser && loggedInUser.discountReady) { %>
                    <p class="discount-text"><strong>Discount Available:</strong> You may choose to use your 20% discount below.</p>
                <% } %>

                <p><strong>Amount Before Optional Discount:</strong> $<%= amount %></p>
            </div>

            <p class="hint">This is a mock payment for school project only. Do not enter real card details.</p>

            <% if (error) { %>
                <p class="error"><%= error %></p>
            <% } %>

            <form method="POST" action="/confirm-payment">
                <input type="hidden" name="name" value="<%= bookingData.name %>">
                <input type="hidden" name="phone" value="<%= bookingData.phone %>">
                <input type="hidden" name="location" value="<%= bookingData.location %>">
                <input type="hidden" name="court" value="<%= bookingData.court %>">
                <input type="hidden" name="date" value="<%= bookingData.date %>">
                <input type="hidden" name="time" value="<%= bookingData.time %>">
                <input type="hidden" name="players" value="<%= bookingData.players %>">
                <input type="hidden" name="skill" value="<%= bookingData.skill %>">
                <input type="hidden" name="rating" value="<%= bookingData.rating || '' %>">
<% if (loggedInUser && loggedInUser.discountReady) { %>
                    <div class="discount-choice-box">
                        <h3>20% Discount Available</h3>
                        <p>You have unlocked a 20% discount. Do you want to use it for this booking?</p>

                        <label class="discount-radio">
                            <input type="radio" name="applyDiscount" value="yes">
                            Yes, use my discount now. Pay $8.
                        </label>

                        <label class="discount-radio">
                            <input type="radio" name="applyDiscount" value="no" checked>
                            No, save my discount for later. Pay $10.
                        </label>
                    </div>
                <% } else { %>
                    <input type="hidden" name="applyDiscount" value="no">
                <% } %>

                <% if (savedCard) { %>
                    <div class="saved-card-box">
                        <h3>Saved Card Available</h3>
                        <p><strong>Saved Card Number:</strong> <%= savedCard.fullCardNumber %></p>
                        <p><strong>Name:</strong> <%= savedCard.cardName %></p>
                        <p><strong>Expiry:</strong> <%= savedCard.expiry %></p>

                        <label class="discount-radio">
                            <input type="radio" name="useSavedCard" value="yes">
                            Use my saved card
                        </label>

                        <label class="discount-radio">
                            <input type="radio" name="useSavedCard" value="no" checked>
                            Use a new card
                        </label>
                    </div>
                <% } else { %>
                    <input type="hidden" name="useSavedCard" value="no">
                <% } %>

                <div id="newCardFields">
                    <label>Name on Card</label>
                    <input type="text" name="cardName" placeholder="Example: John Tan">

                    <label>Card Number</label>
                    <input type="text" name="cardNumber" placeholder="Enter 16 digits" maxlength="16">

                    <label>Expiry Date</label>
                    <input type="text" name="expiry" placeholder="MM/YY">

                    <label>Save Card Details</label>
                    <label class="discount-radio">
                        <input type="checkbox" name="saveCard" value="yes">
                        Save this card for future payments
                    </label>
                </div>

                <label>CVV</label>
                <input type="password" name="cvv" placeholder="123" maxlength="4" required>

                <p class="hint">For this school demo, the full card number can be saved. CVV is not saved.</p>

                <button type="submit">Confirm Payment</button>
            </form>
        </div>
    </div>

    <script>
        const savedCardRadios = document.querySelectorAll("input[name='useSavedCard']");
        const newCardFields = document.getElementById("newCardFields");

        function toggleCardFields() {
            let useSaved = false;

            for (let i = 0; i < savedCardRadios.length; i++) {
                if (savedCardRadios[i].checked && savedCardRadios[i].value === "yes") {
                    useSaved = true;
                }
            }

            if (newCardFields) {
                newCardFields.style.display = useSaved ? "none" : "block";
            }
        }

        for (let i = 0; i < savedCardRadios.length; i++) {
            savedCardRadios[i].addEventListener("change", toggleCardFields);
        }

        toggleCardFields();
    </script>

</body>
</html>
