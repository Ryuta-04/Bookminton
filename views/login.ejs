<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="navbar">
        <h2>Bookminton</h2>
        <div>
            <a href="/">Home</a>
            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/locations">Edit Location</a>
            <% } else { %>
                <a href="/locations">View Locations</a>
            <% } %>
            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/feedback">Feedback</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/bookings">All Bookings</a>
                <a href="/admin-feedback">Feedbacks</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/my-bookings">My Bookings</a>
            <% } %>

            <% if (loggedInUser) { %>
                <% if (loggedInUser && loggedInUser.role === "user") { %>
                    <a href="/profile">Profile</a>
                <% } %>
                <span class="login-text">Hi, <%= loggedInUser.username %> (<%= loggedInUser.role %>)</span>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </div>

    <div class="container">
        <div class="form-box login-box">
            <h1>Login</h1>

            <% if (error) { %>
                <p class="error"><%= error %></p>
            <% } %>

            <form method="POST" action="/login">
                <label>Username</label>
                <input type="text" name="username" required>

                <label>Password</label>
                <input type="password" name="password" required>

                <button type="submit">Login</button>
            </form>

            <p class="bottom-text">
                No account yet? <a href="/register">Register here</a>
            </p>
        </div>
    </div>

</body>
</html>
