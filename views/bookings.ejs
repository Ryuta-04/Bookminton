<!DOCTYPE html>
<html>
<head>
    <title>All Bookings</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="navbar">
        <h2>Bookminton</h2>
        <div>
            <a href="/">Home</a>
            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/locations">Edit Location</a>
            <% } else { %>
                <a href="/locations">View Locations</a>
            <% } %>
            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/feedback">Feedback</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "admin") { %>
                <a href="/bookings">All Bookings</a>
                <a href="/admin-feedback">Feedbacks</a>
            <% } %>

            <% if (loggedInUser && loggedInUser.role === "user") { %>
                <a href="/my-bookings">My Bookings</a>
            <% } %>

            <% if (loggedInUser) { %>
                <% if (loggedInUser && loggedInUser.role === "user") { %>
                    <a href="/profile">Profile</a>
                <% } %>
                <span class="login-text">Hi, <%= loggedInUser.username %> (<%= loggedInUser.role %>)</span>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </div>

    <div class="container">
        <h1>All Court Bookings</h1>
        <p class="notice">Admin view: only admin can view all bookings, edit, delete and manage ratings.</p>

        <form class="search-box" method="GET" action="/bookings">
            <input type="text" name="search" placeholder="Search by name, location, court, skill or user" value="<%= search || '' %>">
            <button type="submit">Search</button>
            <a class="small-btn" href="/bookings">Reset</a>
        </form>

        <% if (bookings.length === 0) { %>
            <div class="empty-box">
                <p>No bookings found.</p>
                <a class="btn" href="/add">Add Booking</a>
            </div>
        <% } else { %>
            <div class="table-box">
                <table>
                    <tr>
                        <th>User</th>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Court</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Players</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>

                    <% for (let i = 0; i < bookings.length; i++) { %>
                        <tr>
                            <td><%= bookings[i].createdBy %></td>
                            <td><%= bookings[i].name %></td>
                            <td><%= bookings[i].location %></td>
                            <td><%= bookings[i].court %></td>
                            <td><%= bookings[i].date %></td>
                            <td><%= bookings[i].time %></td>
                            <td><%= bookings[i].players %></td>
                            <td><%= bookings[i].rating %></td>
                            <td>
                                <a class="small-btn" href="/bookings/<%= bookings[i].id %>">Details</a>
                                <a class="small-btn edit" href="/edit/<%= bookings[i].id %>">Edit</a>

                                <form class="delete-form" method="POST" action="/delete/<%= bookings[i].id %>">
                                    <button class="small-btn delete" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                </table>
            </div>
        <% } %>
    </div>

</body>
</html>
